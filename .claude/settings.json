{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path' | grep -E '\\.(cpp|hpp|h|c)$' | xargs -I{} clang-format -i {}"
                    }
                ]
            }
        ]
    }
}