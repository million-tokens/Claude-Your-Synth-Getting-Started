{
    "permissions": {
        "allow": [
            "Bash(chmod +x *)",
            "Bash(ls *)",
            "Bash(find *)",
            "Bash(cmake *)",
            "Bash(make *)",
            "Bash(jq *)",
            "Read"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path' | grep -E '\\.(cpp|hpp|h|c)$' | xargs -I{} clang-format -i {}"
                    }
                ]
            }
        ]
    }
}
